# ========================================================
# QuickClip Environment Variables (.env)
# ========================================================

# Your Supabase Project URL (from Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Anon / Public Key (safe for client-side use with RLS)
# DO NOT USE the service_role secret here!
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Configurable Room Lifetime in hours (Default: 24)
VITE_ROOM_EXPIRY_HOURS=24

# Optional: Maximum text length (Default: 50000)
VITE_MAX_TEXT_LENGTH=50000

# Optional: Maximum image size in bytes (Default: 10485760 = 10 MB)
VITE_MAX_IMAGE_SIZE_BYTES=10485760
